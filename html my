<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Hand Controlled Space Animation</title>

<style>
  body { margin: 0; overflow: hidden; background: black; }
  video { position: absolute; right: 10px; top: 10px; width: 200px; border: 2px solid white; }
</style>

</head>
<body>

<video id="webcam" autoplay></video>
<script src="https://cdn.jsdelivr.net/npm/handtrackjs/dist/handtrack.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r148/three.min.js"></script>

<script>
let scene, camera, renderer;
let solarGroup;
let earth, planet1, planet2;
let model, video;

// Init Three.js
function initThree() {
  scene = new THREE.Scene();
  camera = new THREE.PerspectiveCamera(60, window.innerWidth/window.innerHeight, 1, 1000);
  camera.position.z = 50;

  renderer = new THREE.WebGLRenderer({antialias:true});
  renderer.setSize(window.innerWidth, window.innerHeight);
  document.body.appendChild(renderer.domElement);

  solarGroup = new THREE.Group();
  scene.add(solarGroup);

  // Earth
  let geo = new THREE.SphereGeometry(4, 32,32);
  let mat = new THREE.MeshBasicMaterial({color:0x0099ff});
  earth = new THREE.Mesh(geo, mat);
  solarGroup.add(earth);

  // Planet 1
  planet1 = new THREE.Mesh(new THREE.SphereGeometry(2,20,20), new THREE.MeshBasicMaterial({color:0xff3300}));
  planet1.position.set(15,0,0);
  solarGroup.add(planet1);

  // Planet 2
  planet2 = new THREE.Mesh(new THREE.SphereGeometry(1.5,20,20), new THREE.MeshBasicMaterial({color:0x33ff00}));
  planet2.position.set(-20,0,0);
  solarGroup.add(planet2);

  animate();
}

// Render & Animate
function animate() {
  requestAnimationFrame(animate);

  // rotate planets for basic animation
  planet1.rotation.y += 0.04;
  planet2.rotation.y += 0.03;
  
  renderer.render(scene, camera);
}

// Load HandTrack model
function initHandTrack() {
  video = document.getElementById("webcam");
  
  handTrack.startVideo(video).then(status => {
    if (status) {
      handTrack.load().then(l => {
        model = l;
        runDetection();
      });
    }
  });
}

// Detect Hand & update control
function runDetection() {
  model.detect(video).then(predictions => {
    if (predictions.length > 0) {
      const p = predictions[0].bbox;
      const midX = p[0] + p[2]/2;
      const midY = p[1] + p[3]/2;

      // Map hand position to camera rotation
      camera.rotation.y = (midX - window.innerWidth/2) * 0.0005;
      camera.rotation.x = -(midY - window.innerHeight/2) * 0.0005;
    }
    requestAnimationFrame(runDetection);
  });
}

initThree();
initHandTrack();

</script>

</body>
</html>
